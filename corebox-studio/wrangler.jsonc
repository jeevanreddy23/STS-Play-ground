{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sts-play-ground",
  "main": "./worker/index.js",
  "compatibility_date": "2026-07-31",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
