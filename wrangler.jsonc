{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sts-play-ground",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.js", "**/*.mjs"]
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sts-play-ground-db",
      "database_id": "333b255a-852d-4d36-a785-b11582a29b65",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "PLANS",
      "id": "a876c96e191945cfaf66e20ae5ef1b6e"
    }
  ],
  "observability": {
    "enabled": true
  }
}
